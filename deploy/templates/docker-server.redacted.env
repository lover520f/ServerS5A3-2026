# Docker protocol and resource reference, reviewed 2026-11-01.
# Generate your runtime from instance.json; this file is a comparison excerpt.
# Replace <...> with values generated for your own deployment.

# Matched official-24.9 client protocol.
DNFBRIDGE_CURRENT_CLIENT_VERSION=official-24.9
DNFBRIDGE_GAME_UPPER_HEADER=server16
DNFBRIDGE_GAME_UPPER_BODY_CODEC=plaintext
DNFBRIDGE_GAME_UPPER_CLIENT_BODY_CODEC=plaintext
DNFBRIDGE_DPROTO_MODE=legacy_patch

# Tournament opponents require vendor mode. Keep horse racing disabled.
DNFBRIDGE_DUNGEON_TOURNAMENT=vendor
DNFBRIDGE_JOUST_EVENT_ENABLED=false
DNFBRIDGE_PACKET_LOG=false

# Relative paths inside the game container; select the external ETC at prepare.
DNFBRIDGE_PVF_PATH=data/dnf/Script.pvf
DNFBRIDGE_CHANNEL_INFO_PATH=data/dnf/channel.override.etc
DNFBRIDGE_CHANNEL_INFO_BODY_MODE=latest
DNFBRIDGE_CHANNEL_SERVER_INDEX=1
DNFBRIDGE_CHANNEL_ADVERTISE_SERVER_INDEX=<CATALOG_ADVERTISE_SERVER_INDEX>
DNF_SCRIPT_VERSION=59
TZ=Asia/Shanghai

# Container bind addresses and the player-reachable advertised address differ.
DNFBRIDGE_CHANNEL_LISTEN=<GAME_CONTAINER_IP>:7001
DNFBRIDGE_GAME_LISTEN_HOST=<GAME_CONTAINER_IP>
DNFBRIDGE_SERVER_IP=<PLAYER_REACHABLE_GAME_IP>
DNFBRIDGE_ACCOUNT_API_LISTEN=<GAME_CONTAINER_IP>:17002
DNFBRIDGE_PARTY_UDP_RELAY_MODE=embedded
DNFBRIDGE_PARTY_UDP_RELAY_PORT_START=30000
DNFBRIDGE_PARTY_UDP_RELAY_PORT_COUNT=64

# Credentials are generated locally. LOGIN_TOKEN is a boolean, not a credential.
DNFBRIDGE_ACCOUNT_API_DSN=<GENERATED_DATABASE_DSN>
DNFBRIDGE_ACCOUNT_API_ALLOW_REGISTER=true
DNFBRIDGE_ACCOUNT_API_LOGIN_TOKEN=true
# Optional: generated only when game management access is configured.
# DNFBRIDGE_PLAYER_ADMIN_SECRET=<GENERATED_ADMIN_SECRET>
